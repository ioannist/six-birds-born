import BornCalculus.Valuations

namespace BornCalculus
open Matrix
open scoped BigOperators

/-- The trace-one perturbation used by the finite-fragment certificate. -/
def fragmentWitness (ε : ℝ) : M2 := !![1 + ε, 0; 0, -ε]

theorem fragmentWitness_trace (ε : ℝ) : trace (fragmentWitness ε) = 1 := by
 simp [fragmentWitness, trace, Fin.sum_univ_two]

theorem fragmentWitness_not_density (ε : ℝ) (hε : 0 < ε) :
 ¬ IsDensity (fragmentWitness ε) := by
 intro h
 have hn : 0 ≤ fragmentWitness ε 1 1 := h.1.diag_nonneg
 change 0 ≤ -ε at hn
 linarith

theorem fragmentWitness_pairing (ε : ℝ) (E : M2) :
 pairing (fragmentWitness ε) E = E 0 0 + ε * (E 0 0 - E 1 1) := by
 simp [pairing, fragmentWitness, trace, vecMul, dotProduct, Fin.sum_univ_two]
 ring

theorem fragmentWitness_valuation_laws (ε : ℝ) :
 pairing (fragmentWitness ε) 0 = 0 ∧ pairing (fragmentWitness ε) 1 = 1 ∧
 ∀ E F : M2, pairing (fragmentWitness ε) (E + F) =
   pairing (fragmentWitness ε) E + pairing (fragmentWitness ε) F := by
 simp [pairing, fragmentWitness_trace, Matrix.mul_add, Matrix.trace_add]

private theorem finite_positive_lower_bound {α : Type*} (s : Finset α)
 (b : α → ℝ) (hb : ∀ x ∈ s, 0 < b x) :
 ∃ ε : ℝ, 0 < ε ∧ ∀ x ∈ s, ε ≤ b x := by
 classical
 induction s using Finset.induction_on with
 | empty => exact ⟨1, by norm_num, by simp⟩
 | @insert a s ha ih =>
   obtain ⟨ε, hε, hbound⟩ := ih (fun x hx => hb x (Finset.mem_insert_of_mem hx))
   refine ⟨min ε (b a), lt_min hε (hb a (Finset.mem_insert_self _ _)), ?_⟩
   intro x hx
   rcases Finset.mem_insert.mp hx with rfl | hx
   · exact min_le_right _ _
   · exact (min_le_left _ _).trans (hbound x hx)

/-- A finite collection of proper effects with strictly interior first
diagonal entries admits a non-PSD trace-one witness whose trace values are
strictly between zero and one. Zero and unit endpoints have values zero/one;
additivity is ordinary trace linearity. This theorem says nothing about the
sub-effect-algebra generated by the collection. -/
theorem finite_fragment_non_density (s : Finset M2)
 (hs : ∀ E ∈ s, 0 < E 0 0 ∧ E 0 0 < 1) :
 ∃ ε : ℝ, 0 < ε ∧ ¬ IsDensity (fragmentWitness ε) ∧
   trace (fragmentWitness ε) = 1 ∧
   ∀ E ∈ s, 0 < pairing (fragmentWitness ε) E ∧
     pairing (fragmentWitness ε) E < 1 := by
 let b : M2 → ℝ := fun E =>
   min (E 0 0) (1 - E 0 0) / (2 * (|E 0 0 - E 1 1| + 1))
 have hb : ∀ E ∈ s, 0 < b E := by
   intro E hE
   have ha := hs E hE
   exact div_pos (lt_min ha.1 (sub_pos.mpr ha.2))
     (by have := abs_nonneg (E 0 0 - E 1 1); positivity)
 obtain ⟨ε, hε, hbound⟩ := finite_positive_lower_bound s b hb
 refine ⟨ε, hε, fragmentWitness_not_density ε hε, fragmentWitness_trace ε, ?_⟩
 intro E hE
 rw [fragmentWitness_pairing]
 have hd : 0 < 2 * (|E 0 0 - E 1 1| + 1) := by
   have := abs_nonneg (E 0 0 - E 1 1); positivity
 have h := (le_div_iff₀ hd).mp (hbound E hE)
 have hleft := h.trans (min_le_left (E 0 0) (1 - E 0 0))
 have hright := h.trans (min_le_right (E 0 0) (1 - E 0 0))
 have habs := abs_nonneg (E 0 0 - E 1 1)
 have hlo := neg_abs_le (E 0 0 - E 1 1)
 have hhi := le_abs_self (E 0 0 - E 1 1)
 constructor <;> nlinarith [mul_nonneg hε.le habs,
   mul_le_mul_of_nonneg_left hlo hε.le, mul_le_mul_of_nonneg_left hhi hε.le]

def fragmentBasisMatrix (E : Fin 3 → M2) : Matrix (Fin 3) (Fin 3) ℝ :=
 fun i => ![E i 0 0, E i 1 1, 2 * E i 0 1]

private theorem symmetric_pairing_coordinates (R E : M2)
 (hR : R.IsHermitian) (hE : E.IsHermitian) :
 pairing R E = E 0 0 * R 0 0 + E 1 1 * R 1 1 + 2 * E 0 1 * R 0 1 := by
 have hr : R 1 0 = R 0 1 := by
   simpa [conjTranspose_apply] using congrArg (fun A : M2 => A 0 1) hR
 have he : E 1 0 = E 0 1 := by
   simpa [conjTranspose_apply] using congrArg (fun A : M2 => A 0 1) hE
 simp [pairing, trace, mul_apply, Fin.sum_univ_two, hr, he]
 ring

/-- Three symmetric effects separate symmetric matrices when their coordinate
determinant is nonzero. The factor two in the off-diagonal column is harmless
for nonvanishing, and explicitly accounts for both trace cross terms. -/
theorem fragment_basis_separates (E : Fin 3 → M2)
 (hE : ∀ i, (E i).IsHermitian) (hdet : (fragmentBasisMatrix E).det ≠ 0)
 (R Q : M2) (hR : R.IsHermitian) (hQ : Q.IsHermitian)
 (h : ∀ i, pairing R (E i) = pairing Q (E i)) : R = Q := by
 have hm : fragmentBasisMatrix E *ᵥ ![R 0 0, R 1 1, R 0 1] =
   fragmentBasisMatrix E *ᵥ ![Q 0 0, Q 1 1, Q 0 1] := by
   funext i
   have hi := h i
   rw [symmetric_pairing_coordinates R (E i) hR (hE i),
     symmetric_pairing_coordinates Q (E i) hQ (hE i)] at hi
   simpa [fragmentBasisMatrix, mulVec, dotProduct, Fin.sum_univ_three] using hi
 have hu : IsUnit (fragmentBasisMatrix E) :=
   (Matrix.isUnit_iff_isUnit_det _).mpr (isUnit_iff_ne_zero.mpr hdet)
 have hv := Matrix.mulVec_injective_iff_isUnit.mpr hu hm
 have h00 : R 0 0 = Q 0 0 := by simpa using congrFun hv 0
 have h11 : R 1 1 = Q 1 1 := by simpa using congrFun hv 1
 have h01 : R 0 1 = Q 0 1 := by simpa using congrFun hv 2
 have hr : R 1 0 = R 0 1 := by
   simpa [conjTranspose_apply] using congrArg (fun A : M2 => A 0 1) hR
 have hq : Q 1 0 = Q 0 1 := by
   simpa [conjTranspose_apply] using congrArg (fun A : M2 => A 0 1) hQ
 ext i j
 fin_cases i <;> fin_cases j <;> simp [h00, h11, h01, hr, hq]

/-- The concrete inventory and determinant are still checked in Python. The
uniform implication from a nonzero determinant to nonrepresentation is proved
here, rather than assumed as a separation hypothesis. -/
theorem finite_fragment_no_density_representation (E : Fin 3 → Effect) (ε : ℝ)
 (hε : 0 < ε) (hdet : (fragmentBasisMatrix (fun i => (E i).val)).det ≠ 0) :
 ¬ ∃ R : Density, ∀ i,
   pairing R.val (E i).val = pairing (fragmentWitness ε) (E i).val := by
 rintro ⟨R, hR⟩
 have hw : (fragmentWitness ε).IsHermitian := by
   ext i j
   fin_cases i <;> fin_cases j <;> simp [fragmentWitness, conjTranspose_apply]
 have he := fragment_basis_separates (fun i => (E i).val)
   (fun i => (E i).property.1.isHermitian) hdet R.val (fragmentWitness ε)
   R.property.1.isHermitian hw hR
 exact fragmentWitness_not_density ε hε (he ▸ R.property)

end BornCalculus
