theorem robust (c : Fin 8) : RobustCheck (raw c) := by
 decide +kernel +revert

theorem ranges (c : Fin 8) : RangeCheck (raw c) := by
 decide +kernel +revert

theorem earlierMax (c : Fin 8) : TieCheck (raw c) := by
 decide +kernel +revert

def certified (c : Fin 8) : CertifiedCase :=
 ⟨raw c,frame c,moments c,pair c,earlier c,atoms c,reads c,robust c,ranges c,earlierMax c⟩

