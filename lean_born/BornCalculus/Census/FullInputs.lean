def partition : (Fin 265 × Fin 8) ⊕ Fin 2 ≃ Fin 2122 :=
 cohortPartition 265 8 2

def fromShard : (Fin 265 × Fin 8) ⊕ Fin 2 → CertifiedCase
 | .inl (s,i) => (shards s).cases i
 | .inr i => Shard265.certified i

def censusCase (c : Fin 2122) : CertifiedCase := fromShard (partition.symm c)

theorem censusCase_partition (x) : censusCase (partition x) = fromShard x := by
 simp only [censusCase,Equiv.symm_apply_apply]

theorem sum_cases (weight : CertifiedCase → ℕ) :
 (∑ c : Fin 2122, weight (censusCase c)) =
 (∑ s : Fin 265, ∑ i : Fin 8, weight ((shards s).cases i)) +
 (∑ i : Fin 2, weight (Shard265.certified i)) := by
 simpa only [censusCase,partition,fromShard] using sum_through_partition 265 8 2 fromShard weight

theorem census_activeCount_total :
 (∑ c : Fin 2122, (censusCase c).raw.activeCount) = 17008 := by
 rw [sum_cases (fun C => C.raw.activeCount)]
 have h : (∑ s : Fin 265, ∑ i : Fin 8, ((shards s).cases i).raw.activeCount) =
   ∑ s : Fin 265, (shards s).active := by
   apply Finset.sum_congr rfl
   intro s _
   exact (shards s).active_total
 rw [h]
 change (∑ s : Fin 265, (shards s).active) +
   (∑ i : Fin 2, (Shard265.raw i).activeCount) = 17008
 rw [Shard265.activeCount_total]
 decide +kernel

